---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="One-button jumper"
  description="A tiny reflex game: one obstacle, one button, one ending."
>
  <h1 class="visually-hidden">One-button jumper</h1>
  <canvas id="game" aria-label="Runner game"></canvas>
  <p id="status" role="status" aria-live="polite" class="status"></p>
</Layout>

<script>
  import { startGame } from "../lib/game";

  const canvas = document.getElementById("game");
  const status = document.getElementById("status");
  if (canvas instanceof HTMLCanvasElement && status) {
    startGame(canvas, status);
  }
</script>
